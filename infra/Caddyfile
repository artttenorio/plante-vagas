{$SITE_DOMAIN} {
	encode zstd gzip

	# API: /api/... -> Nest (o prefixo e removido antes de repassar)
	handle_path /api/* {
		reverse_proxy api:3000
	}

	# Site React (SPA): arquivo existente ou index.html
	handle {
		root * /srv/site
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$N8N_DOMAIN} {
	encode gzip
	reverse_proxy n8n:5678
}

{$EVOLUTION_DOMAIN} {
	encode gzip
	reverse_proxy evolution:8080
}
